  "spec": [
    {
      "kind": "sequence",
      "label": "START sets RUN, STOP resets it, and it remembers",
      "steps": [
        {
          "set": {
            "START": true
          },
          "expect": {
            "RUN": true
          },
          "say": "Holding START"
        },
        {
          "set": {
            "START": false
          },
          "expect": {
            "RUN": true
          },
          "say": "After letting go of START"
        },
        {
          "set": {
            "STOP": true
          },
          "expect": {
            "RUN": false
          },
          "say": "Holding STOP"
        },
        {
          "set": {
            "STOP": false
          },
          "expect": {
            "RUN": false
          },
          "say": "After letting go of STOP"
        },
        {
          "set": {
            "START": true
          },
          "expect": {
            "RUN": true
          },
          "say": "Pressing START again"
        },
        {
          "set": {
            "START": false
          },
          "expect": {
            "RUN": true
          },
          "say": "And letting go"
        }
      ],
      "explain": "Memory comes from feedback: each gate's output holds the other gate's input where it is."
    },
    {
      "kind": "no-burnt"
    }
