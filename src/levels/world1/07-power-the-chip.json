      "title": "IC1 · 74HC00 (notch on the left)",
      "rows": [
        [
          "Pins 1, 2 → 3",
          "gate 1: 1A, 1B → 1Y"
        ],
        [
          "Pin 14",
          "VCC, + supply"
        ],
        [
          "Pin 7",
          "GND"
        ],
        [
          "Supply",
          "2–6 V (5 V here)"
        ]
      ]
    }
  },
  "hints": [
    "A chip is powered through its own pins, like any other part. Select IC1: its card says whether it's powered.",
    "Pin 14 is top left (column 10, row f), pin 7 bottom right (column 16, row e). Neither is wired.",
    "A wire from column 10 (rows f–j) to the + rail at the top, and one from column 16 (rows a–d) to a − rail."
  ],
