  "spec": [
    {
      "kind": "sequence",
      "label": "Q copies D while STORE is held, and keeps it",
      "steps": [
        {
          "set": {
            "D": true,
            "E": true
          },
          "expect": {
            "Q": true
          },
          "say": "D on, STORE held"
        },
        {
          "set": {
            "E": false
          },
          "expect": {
            "Q": true
          },
          "say": "STORE let go"
        },
        {
          "set": {
            "D": false
          },
          "expect": {
            "Q": true
          },
          "say": "D switched off (STORE not held)"
        },
        {
          "set": {
            "E": true
          },
          "expect": {
            "Q": false
          },
          "say": "STORE held with D off"
        },
        {
          "set": {
            "E": false
          },
          "expect": {
            "Q": false
          },
          "say": "STORE let go again"
        },
        {
          "set": {
            "D": true
          },
          "expect": {
            "Q": false
          },
          "say": "D switched on (STORE not held)"
        }
      ],
      "explain": "Without the feedback links the last two gates can’t hold anything: memory is outputs feeding back into inputs."
    },
    {
      "kind": "no-burnt"
    }
  ],
  "par": {
    "checks": 1,
    "partsAdded": 2
  },
  "debrief": "A D latch stores one bit: while enabled it follows D, and once the enable drops it holds. Eight of them side by side make a register that holds a byte; clock them and you get the flip-flops every CPU, counter and memory buffer is made of."
