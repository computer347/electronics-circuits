  "brief": {
    "story": "The porch light should come on when the daylight switch is off. The 74HC04 hex inverter is powered and its input is on SA, but the light isn’t connected to the right pin.",
    "goal": "Wire the inverter’s output (pin 2) to the light, so LED1 is lit when SA is off and dark when it’s on.",
    "datasheet": {
      "title": "74HC04 · hex inverter",
      "rows": [
        [
          "Gate 1",
          "in pin 1 → out pin 2"
        ],
        [
          "Pin 1",
          "column 10 (SA)"
        ],
        [
          "Pin 2",
          "column 11"
        ],
        [
          "Light",
          "R1 in column 20"
        ]
      ]
    }
  },
  "hints": [
    "Pins count from the notch: pin 1 is column 10, pin 2 is column 11, along row e.",
    "The light’s resistor R1 starts in column 20. One wire from the output pin’s column to column 20.",
    "A wire from column 11 (pin 2) to column 20. From column 10 instead, the light would just copy SA."
  ],
