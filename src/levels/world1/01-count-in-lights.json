  "brief": {
    "story": "The club's scoreboard shows numbers in binary: four LEDs worth 8, 4, 2 and 1, each with its own switch. Tonight's score is 13. Someone says the 4 hasn't lit since a resistor got swapped.",
    "goal": "Make the four LEDs show 13 in binary (8 + 4 + 1: on, on, off, on), with nothing burnt.",
    "datasheet": {
      "title": "Binary place values",
      "rows": [
        ["LED8 · LED4 · LED2 · LED1", "worth 8, 4, 2, 1"],
        ["On", "1: count it"],
        ["Off", "0: skip it"],
        ["13", "8 + 4 + 1 = 1101"]
      ]
    }
  },
  "hints": [
    "Each switch lights one LED. 13 is 8 + 4 + 1: switch on S8, S4 and S1, and leave S2 off.",
    "If an LED stays dark with its switch on, measure across its resistor. A 470 Ω resistor should take about 7 V; if it takes almost all 9 V and the LED gets nothing, the resistor is far too big.",
    "R4 is 47 kΩ (yellow violet orange), not 470 Ω. Select it and set it to 470 Ω."
